#!/usr/bin/env bash
# Thin wrapper kept for muscle memory; `nh os <action>` works directly too
# (NH_FLAKE points at this repo, see modules/nix.nix).
set -euo pipefail

ACTION=${1:-build}
if ! [[ "$ACTION" =~ ^(build|test|switch|boot)$ ]]; then
  echo "Usage: $0 {build|test|switch|boot} [extra nh args...]" >&2
  exit 1
fi
shift || true

# nh evaluates as this user (so the private git+ssh inputs use your SSH key)
# and only escalates for activation.
exec nh os "$ACTION" "$(dirname "$0")" "$@"
